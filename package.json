{
  "name": "ipfs-file-pin-service",
  "version": "2.0.0",
  "description": "Helia node that pins IPFS files. Activated by psf-slp-indexer.",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "test": "npm run test:unit",
    "test:all": "export SVC_ENV=test && c8 --reporter=text mocha --exit --timeout 15000 --recursive test/unit test/e2e/automated/",
    "test:unit": "export SVC_ENV=test && c8 --reporter=text mocha --exit --timeout 15000 --recursive test/unit/",
    "test:e2e:auto": "export SVC_ENV=test && mocha --exit --timeout 15000 test/e2e/automated/",
    "start:e2e:server": "export SVC_ENV=test && node index.js",
    "test:temp": "export SVC_ENV=test && mocha --exit --timeout 15000 -g '#rate-limit' test/unit/json-rpc/",
    "lint": "standard --env mocha --fix",
    "docs": "./node_modules/.bin/apidoc -i src/ -o docs",
    "coverage": "c8 report --reporter=text-lcov | coveralls",
    "coverage:report": "export SVC_ENV=test && c8 --reporter=html mocha --exit --timeout 15000 --recursive test/unit/ test/e2e/automated/"
  },
  "author": "Chris Troutner <chris.troutner@gmail.com>",
  "license": "MIT",
  "apidoc": {
    "title": "ipfs-file-pin-service",
    "url": "localhost:5000"
  },
  "repository": "Permissionless-Software-Foundation/ipfs-file-pin-service",
  "dependencies": {
    "axios": "1.21.1",
    "bcryptjs": "2.4.3",
    "glob": "7.1.6",
    "helia-coord": "2.0.3",
    "jsonrpc-lite": "2.2.0",
    "jsonwebtoken": "9.0.3",
    "jwt-bch-lib": "1.3.0",
    "kcors": "2.2.2",
    "koa": "2.16.4",
    "koa-body": "8.0.1",
    "koa-bodyparser": "4.3.0",
    "koa-convert": "2.0.0",
    "koa-generic-session": "2.1.1",
    "koa-logger": "3.2.1",
    "koa-mount": "4.0.0",
    "koa-passport": "6.0.0",
    "koa-router": "10.0.0",
    "koa-static": "5.0.0",
    "koa2-ratelimit": "1.1.3",
    "line-reader": "0.4.0",
    "mime-types": "2.1.35",
    "minimal-slp-wallet": "7.1.7",
    "mongoose": "9.13.1",
    "node-fetch": "npm:@achingbrain/node-fetch@2.6.7",
    "nodemailer": "10.6.1",
    "passport-local": "1.0.0",
    "psf-multisig-approval": "2.2.0",
    "psffpp": "1.4.1",
    "public-ip": "6.0.1",
    "winston": "3.3.3",
    "winston-daily-rotate-file": "4.5.0"
  },
  "devDependencies": {
    "apidoc": "0.51.1",
    "c8": "7.12.0",
    "chai": "4.3.0",
    "coveralls": "3.1.0",
    "husky": "4.3.8",
    "lodash.clonedeep": "4.5.0",
    "mocha": "10.0.0",
    "semantic-release": "19.0.3",
    "sinon": "9.2.4",
    "standard": "17.0.0",
    "uuid": "8.3.2"
  },
  "release": {
    "publish": [
      {
        "path": "@semantic-release/npm",
        "npmPublish": false
      }
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run lint"
    }
  },
  "standard": {
    "ignore": [
      "/test/unit/mocks/**/*.js"
    ]
  },
  "overrides": {
    "sequelize": "6.37.5",
    "@multiformats/multiaddr-to-uri": {
      "@multiformats/multiaddr": "12.5.1"
    },
    "shell-quote": "1.12.0"
  }
}